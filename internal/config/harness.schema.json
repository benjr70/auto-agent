{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/benjr70/auto-agent/plugin/schema/harness.schema.json",
  "title": "Harness config",
  "description": "The committed .auto-agent/harness.json a Target Project declares (ADR 0002). Repo facts only; account and machine facts live in the Host env. The default branch is detected, never declared.",
  "type": "object",
  "additionalProperties": false,
  "required": ["commit_scopes", "commands", "pick"],
  "properties": {
    "$schema": { "type": "string" },
    "commit_scopes": {
      "description": "Conventional-commit scopes the implementer may use.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "test"],
      "properties": {
        "install": { "type": "string", "minLength": 1 },
        "test": { "type": "string", "minLength": 1 },
        "lint": { "type": "string", "minLength": 1 },
        "lockfile_refresh": { "type": "string", "minLength": 1 },
        "plan_gated_paths": {
          "description": "Globs whose touch requires a plan comment before implementation.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pick": {
      "description": "The pick signal: exactly one of a Project board with a priority field, or labels only.",
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["project"] },
        { "required": ["labels"] }
      ],
      "properties": {
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number"],
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "priority_field": { "type": "string", "minLength": 1, "default": "Priority" },
            "order": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "default": ["P0", "P1", "P2"]
            }
          }
        },
        "labels": {
          "description": "Label-only pick: AFK tickets are taken oldest first. An empty object; the harness labels are fixed vocabulary.",
          "type": "object",
          "additionalProperties": false
        }
      }
    },
    "docs_research_prefix": { "type": "string", "minLength": 1, "default": "docs/research/" },
    "required_checks": {
      "description": "CI check names that must be green; empty means every check.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "rounds": {
      "description": "The five documented round caps. Every other numeric constant is an undocumented env override.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pr_watch": { "type": "integer", "minimum": 1, "default": 10 },
        "manual_verify": { "type": "integer", "minimum": 1, "default": 3 },
        "revise": { "type": "integer", "minimum": 1, "default": 3 },
        "deps_fix": { "type": "integer", "minimum": 1, "default": 3 },
        "pause_resume": { "type": "integer", "minimum": 1, "default": 3 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hermetic": {
          "description": "The Environment provider (ADR 0003). Absent means the Bootstrap state.",
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "smoke": { "type": "boolean", "default": false }
          }
        },
        "deployed": {
          "description": "The deployed tier, presence-gated; `enabled` is the quick switch.",
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "enabled": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "surfaces": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url_key", "paths"],
        "properties": {
          "kind": { "enum": ["browser", "electron", "cli", "api"] },
          "url_key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "viewport": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
          "launcher": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dependabot": {
      "description": "The deps-land lane, presence-gated; `enabled` is the quick switch.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "docker": { "type": "boolean", "default": false }
      }
    }
  }
}
