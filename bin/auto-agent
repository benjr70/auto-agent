#!/usr/bin/env bash
# auto-agent: the CLI engine of the harness (ADR 0009). The /auto-agent:setup
# skill drives it stage by stage; every subcommand also runs unattended.
#
# Usage:
#   auto-agent check-config <target-dir>     validate <target-dir>/.auto-agent/harness.json
#   auto-agent show-config <target-dir>      print the resolved config JSON other libs read
#   auto-agent fire [--dry-run] [<target-dir>]
#                                            run one Fire (lib/fire.sh); --dry-run runs the
#                                            no-op skill, against the fixture when no target
#   auto-agent pickup-triage [<target-dir>]  the read-only pickup verdict (lib/pickup-triage.sh)
#   auto-agent work-probe [<target-dir>]     one Work Probe scan (lib/work-probe.sh)
#   auto-agent help
#
# Exit codes, per command:
#   check-config, show-config   0 ok, 1 config invalid, 2 usage or file error,
#                               3 repo detection failed
#   fire                        claude's own exit code; 1 bad config, 2 usage or
#                               missing baseline
#   pickup-triage               0 for every verdict from in-flight down (branch on
#                               .verdict), 2 no-config, 3 no-gh, 4 wrong-login
#   work-probe                  0 with the scan JSON, 2 no-config
# <target-dir> defaults to AUTO_AGENT_TARGET_DIR from the Host env.

set -uo pipefail

AUTO_AGENT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/harness-config.sh
. "${AUTO_AGENT_ROOT}/lib/harness-config.sh"
# shellcheck source=../lib/fire.sh
. "${AUTO_AGENT_ROOT}/lib/fire.sh"
# shellcheck source=../lib/pickup-triage.sh
. "${AUTO_AGENT_ROOT}/lib/pickup-triage.sh"
# shellcheck source=../lib/work-probe.sh
. "${AUTO_AGENT_ROOT}/lib/work-probe.sh"

usage() {
    sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# need_target <cmd> <target> : usage error when the target dir argument is missing
need_target() {
    if [ -z "${2:-}" ]; then
        echo "auto-agent $1: target dir required" >&2
        return 2
    fi
}

cmd_check_config() {
    need_target check-config "${1:-}" || return $?
    harness_config_check "$1" || return $?
    echo "ok: $1/${HARNESS_CONFIG_DIRNAME}/${HARNESS_CONFIG_FILENAME} matches the Harness config schema"
}

cmd_show_config() {
    need_target show-config "${1:-}" || return $?
    harness_config_load "$1"
}

cmd_fire() {
    fire_run "$@"
}

cmd_pickup_triage() {
    pickup_triage "${1:-}"
}

cmd_work_probe() {
    wp_scan "${1:-}"
}

main() {
    local cmd="${1:-help}"
    shift || true
    case "${cmd}" in
        check-config) cmd_check_config "$@" ;;
        show-config)  cmd_show_config "$@" ;;
        fire)         cmd_fire "$@" ;;
        pickup-triage) cmd_pickup_triage "$@" ;;
        work-probe)   cmd_work_probe "$@" ;;
        help|-h|--help) usage ;;
        *) echo "auto-agent: unknown command '${cmd}'" >&2; usage >&2; return 2 ;;
    esac
}

main "$@"
