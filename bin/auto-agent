#!/usr/bin/env bash
# auto-agent: the CLI engine of the harness (ADR 0009). The /auto-agent:setup
# skill drives it stage by stage; every subcommand also runs unattended.
#
# Usage:
#   auto-agent check-config <target-dir>     validate <target-dir>/.auto-agent/harness.json
#   auto-agent show-config <target-dir>      print the resolved config JSON other libs read
#   auto-agent fire [--dry-run|--resolve-dry-run <N>|--noop] [<target-dir>]
#                                            run one Fire (lib/fire.sh): /auto-agent:afk-pickup.
#                                            --dry-run runs the pickup skill's dry-run (a pick
#                                            verdict, no GitHub write); --resolve-dry-run <N>
#                                            runs the resolve lane's dry-run on Decision
#                                            ticket <N> (research written under the research
#                                            prefix, no GitHub write); --noop runs the no-op
#                                            plugin-load skill; all three default to the fixture
#   auto-agent pickup-triage [<target-dir>]  the read-only pickup verdict (lib/pickup-triage.sh)
#   auto-agent work-probe [<target-dir>]     one Work Probe scan (lib/work-probe.sh)
#   auto-agent pr-triage [<target-dir>]      which open PR needs reconciling (lib/pr-triage.sh)
#   auto-agent docs-only-gate <args...>      lib/docs-only-gate.sh, the docs-only merge gate
#   auto-agent deps-gate <args...>           lib/deps-gate.sh, the Dependabot merge gate
#   auto-agent ci-wait <args...>             lib/ci-wait.sh, block until a PR's checks settle
#   auto-agent token-usage <args...>         lib/token-usage.sh scan|markdown|post
#   auto-agent usage-sensor                  lib/usage-sensor.sh: the Gate verdict for the
#                                            declared auth mode (JSON on stdout; the Daemon
#                                            fires on .shouldFire, the Dashboard shells to it)
#   auto-agent park status|probe|enter [--reason <text>]|leave|reprobe
#                                            lib/daemon-park.sh: the parked state behind a
#                                            dead Claude credential and its hourly re-probe
#   auto-agent pick-publish publish|unpublish --issue <N> [--priority <P>]
#                                            lib/pick-publish.sh: put an AFK ticket on the pick
#                                            signal the Harness config declares (Project +
#                                            Priority, or nothing under a label-only pick)
#   auto-agent labels-ensure [--list]        lib/labels-ensure.sh: create the harness labels
#                                            create-if-missing
#   auto-agent vendored-skills check [--upstream]|sync [--commit <ref>]|list
#                                            lib/vendored-skills.sh: the upstream skills the
#                                            plugin vendors and their pinned commit
#   auto-agent provider-check [--pr <N>] [<target-dir>]  (also --pr=<N>)
#                                            lib/provider-check.sh: drive the Target Project's
#                                            Environment provider through the ADR 0003 contract
#                                            (down, up --pr N, the key block, smoke, down) and
#                                            print one verdict
#   auto-agent runbook-check [--list] [<plugin-dir>]
#                                            lib/runbook-check.sh: the plugin's skills, agents
#                                            and hooks still carry their load-bearing rules and
#                                            no Target Project literal
#   auto-agent help
#
# Exit codes, per command:
#   check-config, show-config   0 ok, 1 config invalid, 2 usage or file error,
#                               3 repo detection failed
#   fire                        claude's own exit code; 1 bad config, 2 usage,
#                               missing baseline or a checkout that cannot be
#                               reset, 3 repo or default branch unresolvable
#   pickup-triage               0 for every verdict from in-flight down (branch on
#                               .verdict), 2 no-config, 3 no-gh, 4 wrong-login
#   work-probe                  0 with the scan JSON, 2 no-config
#   pr-triage                   0 a PR was picked, 1 nothing needs attention
#   docs-only-gate, deps-gate   0 approved, 1 refused (the JSON .reason says why)
#   ci-wait                     0 green, 1 fail, 2 timeout, 3 error
#   token-usage                 0 ok, 2 usage, 3 no transcripts, 4 post failed
#   usage-sensor                0 verdict computed (branch on .shouldFire), 4 auth-dead
#                               (park), 5 mode mismatch, 6 api-key refuses to start
#   park                        status 0; probe 0 logged in, 1 not; enter 0 parked,
#                               1 parked but the issue could not be opened; leave 0;
#                               reprobe 0 not parked or un-parked, 1 still parked
#   pick-publish                0 done, 1 gh failed (the JSON .reason says why), 2 usage
#   labels-ensure               0 every label present, 1 a read or create failed, 2 no config
#   vendored-skills             0 ok, 1 a check failed or sync could not fetch, 2 usage
#   provider-check              0 conforms, 1 contract violation (the verdict names
#                               it), 2 usage or no config, 3 no hermetic tier
#                               (Bootstrap state), 4 this machine could not boot
#                               the environment
#   runbook-check               0 every rule present, 1 a rule or literal check
#                               failed, 2 usage
# <target-dir> defaults to AUTO_AGENT_TARGET_DIR from the Host env. The four
# gate/wait/usage commands read the Target Project from the same place
# (HARNESS_CONFIG_JSON, or AUTO_AGENT_TARGET_DIR from the Host env).

set -uo pipefail

AUTO_AGENT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/harness-config.sh
. "${AUTO_AGENT_ROOT}/lib/harness-config.sh"
# shellcheck source=../lib/fire.sh
. "${AUTO_AGENT_ROOT}/lib/fire.sh"
# shellcheck source=../lib/pickup-triage.sh
. "${AUTO_AGENT_ROOT}/lib/pickup-triage.sh"
# shellcheck source=../lib/work-probe.sh
. "${AUTO_AGENT_ROOT}/lib/work-probe.sh"
# shellcheck source=../lib/pr-triage.sh
. "${AUTO_AGENT_ROOT}/lib/pr-triage.sh"

usage() {
    sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# need_target <cmd> <target> : usage error when the target dir argument is missing
need_target() {
    if [ -z "${2:-}" ]; then
        echo "auto-agent $1: target dir required" >&2
        return 2
    fi
}

cmd_check_config() {
    need_target check-config "${1:-}" || return $?
    harness_config_check "$1" || return $?
    echo "ok: $1/${HARNESS_CONFIG_DIRNAME}/${HARNESS_CONFIG_FILENAME} matches the Harness config schema"
}

cmd_show_config() {
    need_target show-config "${1:-}" || return $?
    harness_config_load "$1"
}

cmd_fire() {
    fire_run "$@"
}

cmd_pickup_triage() {
    pickup_triage "${1:-}"
}

cmd_work_probe() {
    wp_scan "${1:-}"
}

cmd_pr_triage() {
    local cfg
    host_env_load
    cfg="$(harness_config_resolve "${1:-}")" || return 2
    HARNESS_CONFIG_JSON="${cfg}" PR_TRIAGE_AUTHOR="${DAEMON_GH_LOGIN:-}" pr_triage_scan
}

# The CLI-shaped libs run as they are; their own usage text answers `--help`.
cmd_exec_lib() {
    local lib="$1"; shift
    exec bash "${AUTO_AGENT_ROOT}/lib/${lib}.sh" "$@"
}

main() {
    local cmd="${1:-help}"
    shift || true
    case "${cmd}" in
        check-config) cmd_check_config "$@" ;;
        show-config)  cmd_show_config "$@" ;;
        fire)         cmd_fire "$@" ;;
        pickup-triage) cmd_pickup_triage "$@" ;;
        work-probe)   cmd_work_probe "$@" ;;
        pr-triage)    cmd_pr_triage "$@" ;;
        docs-only-gate) cmd_exec_lib docs-only-gate "$@" ;;
        deps-gate)    cmd_exec_lib deps-gate "$@" ;;
        ci-wait)      cmd_exec_lib ci-wait "$@" ;;
        token-usage)  cmd_exec_lib token-usage "$@" ;;
        usage-sensor) cmd_exec_lib usage-sensor "$@" ;;
        park)         cmd_exec_lib daemon-park "$@" ;;
        pick-publish) cmd_exec_lib pick-publish "$@" ;;
        labels-ensure) cmd_exec_lib labels-ensure "$@" ;;
        vendored-skills) cmd_exec_lib vendored-skills "$@" ;;
        provider-check) cmd_exec_lib provider-check "$@" ;;
        runbook-check) cmd_exec_lib runbook-check "$@" ;;
        help|-h|--help) usage ;;
        *) echo "auto-agent: unknown command '${cmd}'" >&2; usage >&2; return 2 ;;
    esac
}

main "$@"
